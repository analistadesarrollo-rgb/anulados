NODE_ENV=production
API_PORT=8080
API_VERSION=/api/v1
API_ORIGIN=http://localhost:8086
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_COOKIE_NAME=control_anulados_v2
JWT_TTL=30m

AUTH_DB_HOST=auth-db
AUTH_DB_PORT=3306
AUTH_DB_DATABASE=control_anulados_v2_auth
AUTH_DB_USER=control_v2
AUTH_DB_PASSWORD=replace-me

GAMBLE_DB_HOST=
GAMBLE_DB_PORT=3306
GAMBLE_DB_DATABASE=GAMBLE
GAMBLE_DB_USER=
GAMBLE_DB_PASSWORD=

PERSONA_DB_HOST=
PERSONA_DB_PORT=3306
PERSONA_DB_DATABASE=bdpersona
PERSONA_DB_USER=
PERSONA_DB_PASSWORD=

ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_CONNECT_STRING=
ORACLE_CONFIG_DIR=/opt/oracle/network/admin
ORACLE_CLIENT_LIB_DIR=/opt/oracle/client
DB_ORACLE_THICK_MODE=false